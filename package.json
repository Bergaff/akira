{
  "name": "akira-discord-export",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop:bundle": "esbuild desktop/main.ts --bundle --platform=node --target=node22 --external:electron --format=cjs --outfile=desktop/dist/main.cjs && esbuild desktop/preload.ts --bundle --platform=node --target=node22 --external:electron --format=cjs --outfile=desktop/dist/preload.cjs",
    "desktop": "npm run desktop:bundle && electron .",
    "desktop:dist:win": "npm run desktop:bundle && electron-builder --win nsis --x64",
    "desktop:typecheck": "tsc --noEmit -p tsconfig.desktop.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/node": "^22.20.5",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.40.0"
  },
  "main": "desktop/dist/main.cjs",
  "build": {
    "appId": "ai.akira.discordexport",
    "productName": "Akira Discord Export",
    "directories": {
      "output": "desktop/release"
    },
    "files": [
      "desktop/dist/**/*",
      "desktop/ui/**/*",
      "migrations/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Akira-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "^11.0.1"
    },
    "@electron/universal": {
      "minimatch": "^11.0.1"
    }
  }
}
